{
  "name": "reclems",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:emulators": "firebase emulators:start --only firestore,auth",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-petition-rules-test --only firestore \"pnpm test:rules:run\"",
    "test:rules:run": "vitest run tests/rules",
    "test:e2e": "playwright test",
    "capture:screenshots": "tsx scripts/capture-screenshots.ts",
    "gen:secrets": "tsx scripts/gen-secrets.ts",
    "format": "prettier --write src tests scripts docs README.md .github package.json .prettierrc.json firebase.json firestore.indexes.json vercel.json tsconfig.json next.config.ts vitest.config.ts playwright.config.ts",
    "format:check": "prettier --check src tests scripts docs README.md .github package.json .prettierrc.json firebase.json firestore.indexes.json vercel.json tsconfig.json next.config.ts vitest.config.ts playwright.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "next-intl": "^4.15.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.11.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@next/env": "16.4.6",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "csv-parse": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "firebase-tools": "^14.27.0",
    "jsdom": "^27.4.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@11.25.0"
}
